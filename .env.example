# Aplicacion
NODE_ENV=development
PORT=3000
SINIESTROS_NAME=siniestros

# BD Siniestros (PostgreSQL). DB_PORT=5437 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5437
DB_USER=siniestros
DB_PASSWORD=siniestros
DB_NAME=siniestros

# Muestra las consultas SQL en consola.
DB_LOGGING=false

# ms-emision. Reservada: el diagrama declara siniestros -> emision, pero el
# modulo del monolito no tiene camino de escritura y por ahora ninguna ruta la
# usa (ver README). Nunca una IP ni un host escrito en el codigo.
EMISION_URL=http://emision:3000
